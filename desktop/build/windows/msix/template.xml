<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Masseuse.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FemLed\Masseuse.ai">
    </Installer>
    <PackageInformation
        PackageName="Masseuse.ai"
        PackageDisplayName="Masseuse.ai"
        PublisherName="CN=FemLed"
        PublisherDisplayName="FemLed"
        Version="0.1.0.0"
        PackageDescription="Masseuse.ai for your computer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="ai.masseuse.camlink"
                Description="Masseuse.ai for your computer"
                DisplayName="Masseuse.ai"
                ExecutableName="Masseuse.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Masseuse.ai</DisplayName>
            <PublisherDisplayName>FemLed</PublisherDisplayName>
            <Description>Masseuse.ai for your computer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Masseuse.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
