<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>Masseuse</string>
		<key>CFBundleGetInfoString</key>
		<string>The window around masseuse-camlink (docs/DESKTOP.md).</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<key>CFBundleIconName</key>
		<string>appicon</string>
		<key>CFBundleIdentifier</key>
		<string>ai.masseuse.camlink</string>
		<key>CFBundleName</key>
		<string>Masseuse.ai</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.1.0</string>
		<key>CFBundleVersion</key>
		<string>0.1.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<!-- The shell asks for the camera and the microphone itself
		     (permissions_darwin.go); macOS ends a process that asks without
		     these strings. The same words as the shipped bundle's
		     (packaging/macos/Info.plist). -->
		<key>NSCameraUsageDescription</key>
		<string>Masseuse.ai sends this camera's picture to your masseuse during a session.</string>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>Copyright 2026 FemLed. Apache License 2.0.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Masseuse.ai sends this microphone's sound to your masseuse during a session.</string>
	</dict>
</plist>