<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ffmpeg is signed with the hardened runtime, under which a process may
	     open the camera and the microphone only with these two entitlements.
	     The connector needs none: it opens neither (ffmpeg does), and
	     Bluetooth is not a hardened-runtime gate. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
